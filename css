body {
  font-family: Arial;
  text-align: center;
  background: linear-gradient(135deg, #ff9a9e, #fad0c4);
}

.screen { display: none; }
.screen.active { display: block; }

button {
  padding: 10px 20px;
  margin: 10px;
  background: #ff4081;
  border: none;
  color: white;
  border-radius: 10px;
  cursor: pointer;
}

video {
  width: 300px;
  border-radius: 15px;
  margin: 10px;
}

canvas {
  background: white;
  border: 10px solid pink;
}

#countdown {
  font-size: 40px;
  color: red;
}
